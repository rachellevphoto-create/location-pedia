# Database (PostgreSQL with PostGIS extension)
DATABASE_URL="postgresql://locatepedia:locatepedia@localhost:5432/locatepedia?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="LocatePedia <noreply@example.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_WATERMARK_PUBLIC_ID="locatepedia/watermark"
CLOUDINARY_UPLOAD_FOLDER="locatepedia"

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Bootstrap admin (created during seed)
ADMIN_BOOTSTRAP_EMAIL="admin@locatepedia.local"
ADMIN_BOOTSTRAP_PASSWORD="changeme123!"

# Geocoding (OpenStreetMap Nominatim). Optional override and required UA per usage policy.
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="LocatePedia/1.0 (contact: admin@locatepedia.local)"
